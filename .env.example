# 本项目仿照黑马程序员 AI 私厨项目进行学习；请仅填写自己的测试凭据。

# OpenAI 兼容模型接口（示例：阿里云百炼）
ALIBABA_API_KEY=your_model_api_key
ALIBABA_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL=qwen3.7-plus

# Tavily 联网搜索
TAVILY_API_KEY=your_tavily_api_key
TAVILY_API_URL=

# LangSmith（可选）
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-personal-chef-learning-demo

# 阿里云 OSS（图片上传功能需要）
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=your_oss_bucket
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
